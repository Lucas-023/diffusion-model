# Ignora tudo por padrão
*

# Permite que o Git navegue pelas pastas
!*/

# Apenas arquivos .py e notebooks sobem
!*.py
!*.ipynb

# Permite frontend do webapp e suas dependências
!app/frontend/*
!app/requirements-app.txt

# Bloqueia explicitamente o que não deve subir nunca
__pycache__/
.venv/
venv/
env/
*.pt
*.pth
*.ckpt
*.safetensors
